# ── PostgreSQL — AURA Database ────────────────────────────────────────────
# SQL_HOST=localhost
# SQL_PORT=5433
# SQL_USERNAME=postgres
# SQL_PWD=admin123
# SQL_DB=aura
# DATABASE_URL=postgresql://postgres:admin123@localhost:5433/aura
SQL_HOST=hackathon.alignedautomation.com
SQL_PORT=5432
SQL_USERNAME=squadrons
SQL_PWD=TwlU0KL1LZbZLYS$
SQL_DB=squadrons
DATABASE_URL=postgresql://squadrons:TwlU0KL1LZbZLYS$@hackathon.alignedautomation.com:5432/squadrons
 
# ── Zoho People DB — Employee Agent ──────────────────────────────────────
ZOHO_DB_HOST=zohodb.alignedautomation.com
ZOHO_DB_PORT=5432
ZOHO_DB_NAME=zohodb
ZOHO_DB_USER=reporting_user
ZOHO_DB_PWD=Pwd@123
EMPLOYEE_VIEW=people.vb_employees
 
# ── Ollama / LLM ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ml01.alignedautomation.com:11434
OLLAMA_MODEL=gpt-oss
OLLAMA_EMBED_MODEL=nomic-embed-text
 
# ── Embeddings & Chunking ─────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
 
# ── API Gateway ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8000,https://hackathon.alignedautomati…
 
# ── Web UI (Vite — must be VITE_ prefixed to be exposed to browser) ───────
VITE_API_URL=https://hackathon.alignedautomation.com:8000
VITE_AZURE_TENANT_ID=3dcd35b5-f9c5-48ca-8653-821568ad3397
VITE_AZURE_CLIENT_ID=f03e6b79-ed73-455c-b86a-f15a5d4b360c
 
# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
 
VITE_OFFICE_TOUR_VIDEO_URL = Pune_Office_Tour_Aligned_Automation.mp4
VITE_CULTURE_VIDEO_URL= Pune_Culture_Video_Aligned_Automation.mp4

# ── eSSL Attendance — SQL Server ──────────────────────────────────────────────
ESSL_DB_HOST=db01.alignedautomation.com
ESSL_DB_USER=eSSLReadUser
ESSL_DB_PWD=eSSLReadUser
ESSL_DB_NAME=eSSL
ESSL_ATTENDANCE_VIEW=[dbo].[vbUserTimeEntryLog]
ESSL_DATE_COLUMN=CHECKDATE
ESSL_USER_COLUMN=UserName


# ── LLM Provider Selection ────────────────────────────────────────────────────
# Set exactly ONE of these to True; the others must be False.
USE_Claude_API_Key=True
USE_Groq_API_Key=False
Use_Ollama_LLM=False

# ── Claude API ────────────────────────────────────────────────────────────────
# REQUIRED: Set this key — get it from https://console.anthropic.com/
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── Groq API ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# ── SMTP — Direct email sending from chatbot ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=poc@alignedautomation.com
SMTP_PASSWORD=AC54W4fqMU76Ff4$
SMTP_FROM_NAME=AURA Bot
IT_SUPPORT_EMAIL=itsupport@alignedautomation.com
